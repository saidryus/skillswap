    {
      "name": "Tutor Application Module",
      "item": [
        {
          "name": "UT-TUTOR-008 View document without re-auth returns 403",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('UT-TUTOR-008: HTTP 403 or 404', () => pm.expect([403, 404]).to.include(pm.response.code));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tutor-profiles/000000000000000000000000/document",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "UT-TUTOR-002 Apply without file returns 400",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('UT-TUTOR-002: HTTP 400', () => pm.response.to.have.status(400));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/tutor-profiles",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"courseId\":\"000000000000000000000000\"}" }
          }
        },
        {
          "name": "UT-TUTOR-006 Competency score formula = 0.855",
          "event": [{ "listen": "test", "script": { "exec": [
            "const avg = 4.5; const rec = 80; const comp = 90; const sess = 15;",
            "const score = (avg/5)*0.45 + (rec/100)*0.15 + (comp/100)*0.20 + (Math.min(sess/20,1))*0.20;",
            "pm.test('UT-TUTOR-006: formula = 0.855', () => pm.expect(Math.round(score*1000)/1000).to.equal(0.855));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/ml/status",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "UT-TUTOR-007 Competency score — sessions capped at 20",
          "event": [{ "listen": "test", "script": { "exec": [
            "const component = Math.min(25/20, 1) * 0.20;",
            "pm.test('UT-TUTOR-007: capped component = 0.20', () => pm.expect(component).to.equal(0.20));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/ml/status",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        }
      ]
    },

    {
      "name": "ML Status Module",
      "item": [
        {
          "name": "UT-CONF-004 ML status endpoint reachable",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('UT-CONF-004: HTTP 200', () => pm.response.to.have.status(200));",
            "pm.test('UT-CONF-004: response is object', () => pm.expect(pm.response.json()).to.be.an('object'));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/ml/status",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        }
      ]
    },

    {
      "name": "Session Module",
      "item": [
        {
          "name": "UT-SESS-001 Slot suggestions — invalid tutorId returns 400 or empty",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('UT-SESS-001: 400 or empty slots', () => {",
            "  const status = pm.response.code;",
            "  if (status === 200) {",
            "    const b = pm.response.json();",
            "    const slots = Array.isArray(b) ? b : b.slots || [];",
            "    pm.expect(slots.length).to.equal(0);",
            "  } else { pm.expect([400, 404]).to.include(status); }",
            "});"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/sessions/suggest-slots?tutorId=000000000000000000000000",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }]
          }
        },
        {
          "name": "UT-SESS-005 Book past/invalid slot returns 400 or 404 or 409",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('UT-SESS-005: 400/404/409', () => pm.expect([400, 404, 409]).to.include(pm.response.code));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/sessions",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"tutorId\":\"000000000000000000000000\",\"courseId\":\"000000000000000000000000\",\"date\":\"2020-01-06\",\"startTime\":\"10:00\",\"endTime\":\"11:00\",\"venue\":\"Library\",\"venueType\":\"on-campus\"}" }
          }
        }
      ]
